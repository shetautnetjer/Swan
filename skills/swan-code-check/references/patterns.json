  ],
  "known_bug_canaries": [
    {
      "lang": "python",
      "pattern": "os.system($X, $$$)",
      "docs_expect": [
        "P04"
      ],
      "bug_result": [],
      "bug": "$$$ next to a comma must match >=1 node; docs say it may match none"
    },
    {
      "lang": "typescript",
      "pattern": "spawn($A, $B, { $$$, shell: true })",
      "docs_expect": [
        "T06",
        "T08"
      ],
      "bug_result": [
        "T06"
      ],
      "bug": "same: { shell: true } alone is missed"
    },
    {
      "lang": "typescript",
      "pattern": "shell: true",
      "docs_expect": [],
      "bug_result": [],
