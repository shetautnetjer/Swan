// Maps fixtures/tiny-rs with rust-analyzer and checks the two Rust repairs:
// trait impls recovered from rust-analyzer's symbol names, and uses inside
// nested macro calls found by name. (Was tests/rust_check.ts.)

import std;
import os;
import json;
import .harness;

// A repo that pins a toolchain rustup does not have is still mapped, with
// the default one, and the map says so.
fn rust_pinned_toolchain() {
    let w = "data/rs-pinned";
    rm_rf(w);
    mkdir_p(w);
    var o: u8[>..] = [];
    guard sh(argv(["cp", "-r", "fixtures/tiny-rs", str(w, "/repo")]), "", o) else { return; }
    write_file(str(w, "/repo/rust-toolchain.toml"), "[toolchain]\nchannel = \"1.61.0\"\n");
    var e: u8[>..] = [];
    let code = run(argv(["bin/swan", "map", str(w, "/repo"), str(w, "/map")]), "", o, e);
    var t: u8[>..] = [];
    var e2: u8[>..] = [];
    run(argv(["bin/swan", "query", str(w, "/map/swan.db"), "impls", "Area"]), "", t, e2);
    check("a pinned toolchain that is not installed: mapped with the default one, and said so",
          code == 0 && find(e, "pins toolchain 1.61.0, which is not installed; indexing with") >= 0 &&
          find(t, "Tile") >= 0 && find(t, "Disc") >= 0, str(e[..min(e.len, 600)], "\n", t));
}

// A repo pinning an installed Rust older than rustup's default one: cargo
// keeps the pinned toolchain, and rust-analyzer is given the default one's
// standard library to read (its own left vec! and matches! unresolved).
// rustup's folder here is made up: the test machine has one toolchain.
fn rust_older_pinned_toolchain() {
    let w = "data/rs-older";
    rm_rf(w);
    for d in ["rustup/toolchains/1.70.0-x86_64-unknown-linux-gnu/bin",
              "rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/src/rust/library/core/src", "repo/src"] { mkdir_p(str(w, "/", d)); }
    write_file(str(w, "/rustup/settings.toml"), "version = \"12\"\ndefault_toolchain = \"stable-x86_64-unknown-linux-gnu\"\n");
    write_file(str(w, "/rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/multirust-channel-manifest.toml"),
               "manifest-version = \"2\"\n[pkg.cargo]\nversion = \"0.101.0 (x 2026-10-01)\"\n[pkg.rustc]\nversion = \"1.100.0 (y 2026-10-20)\"\n");
    write_file(str(w, "/rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/src/rust/library/core/src/lib.rs"), "\n");
    write_file(str(w, "/repo/Cargo.toml"), "[package]\nname = \"older\"\nversion = \"0.1.0\"\nedition = \"2021\"\n");
    write_file(str(w, "/repo/src/lib.rs"), "pub fn one() -> u32 {\n    1\n}\n");
    var here: u8[>..] = [];
    var e: u8[>..] = [];
    run(argv(["pwd"]), "", here, e);
    let home = envv("RUSTUP_HOME", str(trim(here), "/", w, "/rustup"));
    let src = str(trim(here), "/", w, "/rustup/toolchains/stable-x86_64-unknown-linux-gnu/lib/rustlib/src/rust/library");
    fn plan(channel: const u8[:], o: u8[>..]&) {
        write_file(str(w, "/repo/rust-toolchain.toml"), str("[toolchain]\nchannel = \"", channel, "\"\n"));
        run(argv(["bin/swan", "cargo-projects", str(w, "/repo")]), home, o, e);
    }
    var o: u8[>..] = [];
    plan("1.70.0", o);
    check("an installed pinned Rust 1.70 under a default 1.100: the default one's library source is read, the toolchain is kept",
          find(o, str("\"sysrootSrc\":\"", src, "\"")) >= 0 && ends_with(trim(o), "}}") && find(e, "its standard library is read from stable") >= 0,
          str(o, "\n", e));
    plan("1.61.0", o);
    check("a pinned Rust that is not installed: the default toolchain runs, with its own library",
          find(o, "sysrootSrc") < 0 && ends_with(trim(o), "\tstable-x86_64-unknown-linux-gnu"), str(o, "\n", e));
    plan("stable", o);
    check("a pinned channel that is the default one: nothing is swapped", trim(o) == ".\t{\"cargo\":{\"features\":\"all\"}}", str(o, "\n", e));
}

// A repo with more cargo projects than the one at its root: each is mapped
// by its own rust-analyzer run and linked to the others by crate name, with
// every cargo feature on. A project that cannot be loaded costs the map
// nothing but its own rows, and the report names it.
fn rust_nested_projects() {
    let w = "data/rs-nested";
    rm_rf(w);
    mkdir_p(w);
    var o: u8[>..] = [];
    guard sh(argv(["cp", "-r", "fixtures/tiny-rs", str(w, "/repo")]), "", o) else { return; }
    let r = str(w, "/repo");
    for d in ["extra/src", "fuzz/src", "tools/gen/src", "broken/src"] { mkdir_p(str(r, "/", d)); }
    let lock = "# This file is automatically @generated by Cargo.\n# It is not intended for manual editing.\nversion = 4\n\n";
    // The root crate: a feature that is off by default, and a crate it
    // depends on by path (built with it, so no project of its own).
    write_file(str(r, "/Cargo.toml"),
               "[package]\nname = \"tiny-rs\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\nextra = { path = \"extra\" }\n\n[features]\nbonus = []\n");
    write_file(str(r, "/Cargo.lock"),
               str(lock, "[[package]]\nname = \"extra\"\nversion = \"0.1.0\"\n\n[[package]]\nname = \"tiny-rs\"\nversion = \"0.1.0\"\ndependencies = [\n \"extra\",\n]\n"));
    var lib: u8[>..] = [];
    read_file(str(r, "/src/lib.rs"), lib);
    lib.append("\n#[cfg(feature = \"bonus\")]\npub fn bonus_area() -> u32 {\n    extra::twice(Tile::new(3).area())\n}\n");
    write_file(str(r, "/src/lib.rs"), lib);
    write_file(str(r, "/extra/Cargo.toml"), "[package]\nname = \"extra\"\nversion = \"0.1.0\"\nedition = \"2021\"\n");
    write_file(str(r, "/extra/src/lib.rs"), "pub fn twice(x: u32) -> u32 {\n    x * 2\n}\n");
    // Cut off from the root by a [workspace] table of its own, as cargo fuzz writes it.
    write_file(str(r, "/fuzz/Cargo.toml"),
               "[package]\nname = \"tiny-fuzz\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[dependencies]\ntiny-rs = { path = \"..\" }\n\n[workspace]\n");
    write_file(str(r, "/fuzz/Cargo.lock"),
               str(lock, "[[package]]\nname = \"extra\"\nversion = \"0.1.0\"\n\n[[package]]\nname = \"tiny-fuzz\"\nversion = \"0.0.0\"\ndependencies = [\n \"tiny-rs\",\n]\n\n",
                   "[[package]]\nname = \"tiny-rs\"\nversion = \"0.1.0\"\ndependencies = [\n \"extra\",\n]\n"));
    write_file(str(r, "/fuzz/src/main.rs"), "use tiny_rs::{Area, Tile};\n\nfn main() {\n    println!(\"{}\", Tile::new(2).area());\n}\n");
    // In no workspace and no crate's path dependency: cargo builds it alone.
    write_file(str(r, "/tools/gen/Cargo.toml"), "[package]\nname = \"codegen\"\nversion = \"0.1.0\"\nedition = \"2021\"\n");
    write_file(str(r, "/tools/gen/Cargo.lock"), str(lock, "[[package]]\nname = \"codegen\"\nversion = \"0.1.0\"\n"));
    write_file(str(r, "/tools/gen/src/main.rs"), "fn twice_local(x: u32) -> u32 {\n    x + x\n}\n\nfn main() {\n    println!(\"{}\", twice_local(2));\n}\n");
    // A project cargo cannot read.
    write_file(str(r, "/broken/Cargo.toml"), "[package\nname = \"broken\"\n\n[workspace]\n");
    write_file(str(r, "/broken/src/lib.rs"), "pub fn lonely() -> u32 {\n    1\n}\n");

    var e: u8[>..] = [];
    let code = run(argv(["bin/swan", "map", r, str(w, "/map")]), "", o, e);
    let db = str(w, "/map/swan.db");
    check("a repo with four cargo projects is mapped although one cannot be loaded", code == 0, str(o[..min(o.len, 1500)], "\n", e[..min(e.len, 600)]));
    check("each project that is not part of another gets a run of its own: fuzz ([workspace]) and tools/gen (alone)",
          find(o, "rust-analyzer scip: ") >= 0 && find(o, "rust project fuzz: ") >= 0 && find(o, "rust project tools/gen: ") >= 0, o);
    check("a crate another one depends on by path is built with it, not run again", find(o, "rust project extra") < 0, o);
    check("the project that could not be loaded is named, with cargo's reason, and so is the crate left without rows",
          find(o, "rust project broken: ") >= 0 && find(o, "not mapped, the map goes on without it") >= 0 && find(o, "unclosed table") >= 0 &&
          find(o, "no rows for these crates: broken") >= 0, o);

    var t1: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", db, "uses", "/Tile"]), "", t1) else { return; }
    check("a use in the fuzz project links to the root project's definition: Tile::new in fuzz/src/main.rs",
          find(t1, "\"relative_path\":\"fuzz/src/main.rs\",\"line\":4") >= 0, t1[..min(t1.len, 1200)]);
    var t2: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", db, "refs", "twice"]), "", t2) else { return; }
    check("code behind a feature that is off by default is resolved: bonus_area's call of extra::twice",
          find(t2, "\"in_symbol\":\"bonus_area\"") >= 0, t2[..min(t2.len, 1200)]);
    var t3: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", db, "symbol", "twice_local"]), "", t3) else { return; }
    check("the crate that stands alone is in the map: tools/gen's twice_local", find(t3, "tools/gen/src/main.rs") >= 0, t3[..min(t3.len, 600)]);

    let code2 = run(argv(["bin/swan", "map", r, str(w, "/map")]), "", o, e);
    check("the next map reuses each project's index and still names the one that fails",
          code2 == 0 && find(o, "rust-analyzer scip: reused") >= 0 && find(o, "rust project fuzz: reused") >= 0 &&
          find(o, "rust project tools/gen: reused") >= 0 && find(o, "no rows for these crates: broken") >= 0, o);
}

fn rust_suite() {
    rust_pinned_toolchain();
    rust_older_pinned_toolchain();
    rust_nested_projects();
    var out: u8[>..] = [];
    guard sh(argv(["scripts/index-repo.sh", "fixtures/tiny-rs", "data/tiny-rs"]), "", out) else { return; }

    // rust-analyzer gives a symbol's signature in SCIP's signature_documentation, not its documentation: the map
    // used to take the doc comment's first line, so Tile/new (no doc comment) had none.
    var sg: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", "data/tiny-rs/swan.db", "symbol", "Tile/new"]), "", sg) else { return; }
    var dsg: json::Node[>..] = []; var xsg: u8[>..] = [];
    let rsg, esg = json::parse(sg, dsg, xsg);
    check("a Rust function's signature is rust-analyzer's: Tile/new is `pub fn new(side: u32) -> Tile`",
          jstr(nth(rsg, 0), "signature") == "pub fn new(side: u32) -> Tile", sg);

    var t1: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", "data/tiny-rs/swan.db", "impls", "Area"]), "", t1) else { return; }
    var d1: json::Node[>..] = []; var x1: u8[>..] = [];
    let r1, e1 = json::parse(t1, d1, x1);
    var names: u8[>..] = [];
    let l1 = json::member(r1, "implementations");
    if l1 { json::each(l1) { s => format(names, jstr(s, "name_path"), "\n"); }; }
    let impls = sorted_join(names);
    check("find_implementations Area: Tile and Disc", impls == "Disc,Tile", impls);

    var t2: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", "data/tiny-rs/swan.db", "hierarchy", "Area/area"]), "", t2) else { return; }
    var d2: json::Node[>..] = []; var x2: u8[>..] = [];
    let r2, e2 = json::parse(t2, d2, x2);
    names.clear();
    let l2 = json::member(r2, "subtypes");
    if l2 { json::each(l2) { s => format(names, jstr(s, "name_path"), "\n"); }; }
    let area = sorted_join(names);
    check("the trait method's implementations are Tile/area and Disc/area", area == "Disc/area,Tile/area", area);

    var t3: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", "data/tiny-rs/swan.db", "symbol", "Tile/new"]), "", t3) else { return; }
    var d3: json::Node[>..] = []; var x3: u8[>..] = [];
    let r3, e3 = json::parse(t3, d3, x3);
    check("impl methods are named by their type: Tile/new", jcount(r3) == 1, t3);

    var t4: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", "data/tiny-rs/swan.db", "uses", "/Shape"]), "", t4) else { return; }
    var d4: json::Node[>..] = []; var x4: u8[>..] = [];
    let r4, e4 = json::parse(t4, d4, x4);
    let shape = json::member(nth(r4, 0), "references");
    var sq = false; var circ = false;
    if shape {
        json::each(shape) { r =>
            if jint(r, "line") == 42 && jstr(r, "via") == "Shape/Square" { sq = true; }
            if jint(r, "line") == 55 { circ = true; }
        };
    }
    // rust-analyzer resolves uses inside vec![...] since its 2026-10 builds;
    // older ones left them to Swan's by-name fallback. Either way it must be
    // found. (From #37.)
    check("Shape::Square inside vec![...] counts as a use of Shape (compiler-resolved or by name)", sq, t4);
    check("Shape::Circle inside assert!(matches!(...)) is found too", circ, t4);

    var t5: u8[>..] = [];
    guard sh(argv(["bin/swan", "query", "data/tiny-rs/swan.db", "uses", "/Tile"]), "", t5) else { return; }
    var d5: json::Node[>..] = []; var x5: u8[>..] = [];
    let r5, e5 = json::parse(t5, d5, x5);
    var tile = false;
    let tr = json::member(nth(r5, 0), "references");
    if tr {
        json::each(tr) { r => if jint(r, "line") == 56 && jstr(r, "via") == "Tile/new" { tile = true; } };
    }
    check("Tile::new inside vec![...] counts as a use of Tile", tile, t5);
}
