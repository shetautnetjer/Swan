#!/bin/sh
# eggshell — run one command sealed off so a code indexer is safe headless.
#
# Guarantees (safe by default):
#   - no network                 (new empty network namespace; loopback only, no routes)
#   - repo is read-only          (whole filesystem remounted read-only inside)
#   - writes go only to OUT      (OUT bind-mounted read-write) and an ephemeral
#                                 tmpfs scratch (HOME + TMPDIR on /dev/shm) that
#                                 is discarded on exit; /tmp is masked for
#                                 containment unless the repo or OUT lives there
#   - if the sandbox cannot be set up, REFUSE (never fall back to running
#     unconfined). Swan's trust gate stays the fallback for whether to attempt
#     build-running indexers at all.
#
# Usage:  eggshell <repo-dir> <out-dir> [--allow-net] -- <cmd> [args...]
#   --allow-net   loosen only (share host network). Use this for an explicitly
#                 trusted repo that must fetch dependencies; off by default.
#
# Exit codes: 2 usage/precondition error; 3 sandbox unavailable (REFUSED);
#             otherwise the wrapped command's own exit code.
set -eu

if [ $# -lt 2 ]; then
  echo "eggshell: usage: eggshell <repo> <out> [--allow-net] -- cmd..." >&2
  exit 2
fi
REPO=$1; shift
OUT=$1; shift

ALLOW_NET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --allow-net) ALLOW_NET=1; shift ;;
    --) shift; break ;;
    *) echo "eggshell: unexpected argument before --: $1" >&2; exit 2 ;;
  esac
done
[ $# -ge 1 ] || { echo "eggshell: no command after --" >&2; exit 2; }

[ -d "$REPO" ] || { echo "eggshell: repo is not a directory: $REPO" >&2; exit 2; }
[ -d "$OUT" ]  || { echo "eggshell: out is not a directory: $OUT"  >&2; exit 2; }
REPO=$(cd "$REPO" && pwd)
OUT=$(cd "$OUT" && pwd)

# Preflight: if unprivileged namespaces are not available, refuse rather than
# run the indexer unconfined.
if ! unshare --user --map-root-user true 2>/dev/null; then
  echo "eggshell: unprivileged namespaces unavailable; REFUSING to run unconfined" >&2
  exit 3
fi

NET_FLAG="--net"
[ "$ALLOW_NET" = "1" ] && NET_FLAG=""   # trust loosening: share host network

export EGG_REPO="$REPO" EGG_OUT="$OUT"
exec unshare --user --map-root-user --mount $NET_FLAG --pid --fork --kill-child \
  /bin/sh -euc '
    mount --make-rprivate /
    mount -o remount,bind,ro /                       # everything read-only

    # Make OUT writable. When OUT is on the read-only root mount (the usual
    # case, and /tmp too where /tmp is part of root) this carves one read-write
    # hole. When OUT is on its own already-writable mount (e.g. a separate
    # tmpfs /tmp), the bind is refused and OUT is used as it is.
    if mount --bind "$EGG_OUT" "$EGG_OUT" 2>/dev/null; then
      mount -o remount,bind,rw "$EGG_OUT" "$EGG_OUT" 2>/dev/null || true
    fi

    # Ephemeral scratch (HOME + TMPDIR) on a fresh /dev/shm tmpfs: a separate
    # read-write mount in every environment, so it never collides with a repo
    # or OUT under /tmp and /tmp never needs masking. Everything stays
    # read-only except the single OUT hole and this scratch.
    mount -t tmpfs none /dev/shm 2>/dev/null || true
    mkdir -p /dev/shm/home /dev/shm/tmp
    export HOME=/dev/shm/home TMPDIR=/dev/shm/tmp

    cd "$EGG_REPO"
    exec "$@"
  ' sh "$@"
