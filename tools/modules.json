{
  "_about": "Per-language tools Swan runs after edits: linters (into get_diagnostics; they must not write into the repo, so their caches are off), formatters (format_file) and test runners (run_tests), which act on the repo by design. Each kind is a list of candidates; the first whose conditions hold is used. when_file: one of these exists in the repo. when_cmd: this command exits 0. Placeholders: {repo}, {python} (the repo's virtualenv, else python3), {tools} (Swan's .tools), {bin} (Swan's tools/node_modules/.bin), {out} (the map folder), {compdb} (the folder of the compile_commands.json that built the map: the repo's own, else the map folder's), {files} and {tests} (one argument each; a candidate needing them is skipped when there are none). parser: how output becomes diagnostics (github: ::error file=..,line=..,col=..::message; cargo: cargo's JSON lines). lsp: a language server swan serve keeps running for live answers (get_diagnostics and find_implementations with live): language_id for didOpen, init the settings as a JSON string (placeholders expanded; sent as initializationOptions and as the answer to workspace/configuration, by section), settle: check (wait for the check a save starts: rust-analyzer) or publish (wait for the file's next published set); quiet_ms: for a server that publishes nothing for a clean file (lua-language-server), how long a silence means no problems.",
  "python": {
    "match": [".py", ".pyi"],
    "lint": [
      {"cmd": ["{tools}/py-tools/bin/ruff", "check", "--no-cache", "--output-format", "github", "--exit-zero", "."], "parser": "github", "source": "ruff"}
    ],
    "format": [
      {"cmd": ["{tools}/py-tools/bin/ruff", "format", "{files}"]}
    ],
    "test": [
      {"when_cmd": ["{python}", "-c", "import pytest"], "cmd": ["{python}", "-m", "pytest", "-q", "-p", "no:cacheprovider", "{tests}"], "env": ["PYTHONDONTWRITEBYTECODE=1"]},
      {"cmd": ["{tools}/py-tools/bin/python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "{tests}"], "env": ["PYTHONDONTWRITEBYTECODE=1"]}
    ],
    "lsp": [
      {"cmd": ["{bin}/pyright-langserver", "--stdio"], "language_id": "python", "settle": "publish",
       "init": "{\"python\":{\"pythonPath\":\"{python}\",\"analysis\":{\"diagnosticMode\":\"openFilesOnly\",\"extraPaths\":[\"{tools}/blender-stubs\"]}}}"}
    ]
  },
  "typescript": {
    "match": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
    "lint": [
      {"cmd": ["{bin}/biome", "lint", "--reporter=github", "--max-diagnostics=none", "."], "parser": "github", "source": "biome"}
    ],
    "format": [
      {"cmd": ["{bin}/biome", "format", "--write", "{files}"]}
    ],
    "test": [
      {"when_file": ["vitest.config.ts", "vitest.config.js", "vitest.config.mts"], "cmd": ["npx", "vitest", "run", "{tests}"]},
      {"cmd": ["bun", "test", "{tests}"]}
    ],
    "lsp": [
      {"cmd": ["{bin}/typescript-language-server", "--stdio"], "language_id": "typescript", "settle": "publish", "init": "{}"}
    ]
  },
  "kotlin": {
    "match": [".kt", ".kts"],
    "lsp": [
      {"cmd": ["{tools}/kotlin-lsp/kotlin-server-263.7084.0/bin/intellij-server", "--stdio", "--system-path", "{out}/kotlin-lsp"],
       "language_id": "kotlin", "settle": "publish", "init": "{}",
       "env": ["GRADLE_USER_HOME={tools}/gradle-home"]}
    ]
  },
  "csharp": {
    "match": [".cs"],
    "lsp": [
      {"cmd": ["{tools}/dotnet-tools/csharp-ls"],
       "language_id": "csharp", "settle": "publish", "init": "{}",
       "env": ["DOTNET_ROOT={tools}/dotnet", "DOTNET_CLI_HOME={tools}/dotnet-home", "NUGET_PACKAGES={tools}/nuget",
               "DOTNET_CLI_TELEMETRY_OPTOUT=1", "DOTNET_NOLOGO=1"]}
    ]
  },
  "cpp": {
    "match": [".c", ".cc", ".cpp", ".cxx", ".h", ".hpp", ".hh", ".hxx", ".cu", ".cuh"],
    "lsp": [
      {"cmd": ["{tools}/clangd/clangd_23.1.0/bin/clangd", "--compile-commands-dir={compdb}", "--log=error"],
       "language_id": "cpp", "settle": "publish", "init": "{}"}
    ]
  },
  "lua": {
    "match": [".lua"],
    "lsp": [
      {"cmd": ["{tools}/lua-ls/bin/lua-language-server", "--logpath={out}/lua-ls-log", "--metapath={out}/lua-ls-meta"],
       "language_id": "lua", "settle": "publish", "quiet_ms": 3000, "init": "{}"}
    ]
  },
  "glsl": {
    "match": [".glsl", ".vert", ".frag", ".comp", ".geom", ".tesc", ".tese"],
    "lsp": [
      {"cmd": ["{tools}/shader-ls/bin/shader-language-server", "--glsl", "--stdio"], "language_id": "glsl", "settle": "publish", "init": "{}"}
    ]
  },
  "hlsl": {
    "match": [".hlsl", ".hlsli", ".fx"],
    "lsp": [
      {"cmd": ["{tools}/shader-ls/bin/shader-language-server", "--hlsl", "--stdio"], "language_id": "hlsl", "settle": "publish", "init": "{}"}
    ]
  },
  "wgsl": {
    "match": [".wgsl"],
    "lsp": [
      {"cmd": ["{tools}/shader-ls/bin/shader-language-server", "--wgsl", "--stdio"], "language_id": "wgsl", "settle": "publish", "init": "{}"}
    ]
  },
  "rust": {
    "match": [".rs"],
    "lint": [
      {"cmd": ["cargo", "clippy", "--workspace", "--all-targets", "--message-format=json", "--keep-going", "--quiet"], "parser": "cargo", "source": "clippy", "env": ["CARGO_TARGET_DIR={out}/cargo-target"]}
    ],
    "format": [
      {"cmd": ["rustfmt", "--edition", "2021", "{files}"]}
    ],
    "test": [
      {"cmd": ["cargo", "test", "--quiet"], "env": ["CARGO_TARGET_DIR={out}/cargo-target"]}
    ],
    "lsp": [
      {"cmd": ["{tools}/rust-analyzer/rust-analyzer"], "language_id": "rust",
       "init": "{\"cargo\":{\"targetDir\":\"{out}/ra-target\"},\"checkOnSave\":true,\"check\":{\"command\":\"check\"}}", "settle": "check",
       "env": ["CARGO_TARGET_DIR={out}/ra-target"]}
    ]
  }
}
