{
  "_about": "Per-language tools Swan runs after edits: linters (into get_diagnostics; they must not write into the repo, so their caches are off), formatters (format_file) and test runners (run_tests), which act on the repo by design. Each kind is a list of candidates; the first whose conditions hold is used. when_file: one of these exists in the repo. when_cmd: this command exits 0. Placeholders: {repo}, {python} (the repo's virtualenv, else python3), {tools} (Swan's .tools), {bin} (Swan's tools/node_modules/.bin), {out} (the map folder), {compdb} (the folder of the compile_commands.json that built the map: the repo's own, else the map folder's), {files} and {tests} (one argument each; a candidate needing them is skipped when there are none). parser: how output becomes diagnostics (github: ::error file=..,line=..,col=..::message; cargo: cargo's JSON lines). lsp: a language server swan serve keeps running for live answers (get_diagnostics and find_implementations with live): language_id for didOpen, init the settings as a JSON string (placeholders expanded; sent as initializationOptions and as the answer to workspace/configuration, by section), settle: check (wait for the check a save starts: rust-analyzer) or publish (wait for the file's next published set); runs_repo_code: the candidate runs the repo's own build files (cargo build scripts, Gradle, MSBuild), so it is used only once the repo is trusted (swan trust <repo>, or SWAN_TRUST_BUILD=1); test runners run the repo's code by design and are not marked. quiet_ms: for a server that publishes nothing for a clean file (lua-language-server), how long a silence means no problems.",
  "python": {
    "match": [".py", ".pyi"],
    "lint": [
      {"cmd": ["{tools}/py-tools/bin/ruff", "check", "--no-cache", "--output-format", "github", "--exit-zero", "."], "parser": "github", "source": "ruff"}
    ],
    "format": [
      {"cmd": ["{tools}/py-tools/bin/ruff", "format", "{files}"]}
    ],
    "test": [
      {"when_cmd": ["{python}", "-c", "import pytest"], "cmd": ["{python}", "-m", "pytest", "-q", "-p", "no:cacheprovider", "{tests}"], "env": ["PYTHONDONTWRITEBYTECODE=1"]},
      {"cmd": ["{tools}/py-tools/bin/python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "{tests}"], "env": ["PYTHONDONTWRITEBYTECODE=1"]}
    ],
    "lsp": [
      {"cmd": ["{bin}/pyright-langserver", "--stdio"], "language_id": "python", "settle": "publish",
       "init": "{\"python\":{\"pythonPath\":\"{python}\",\"analysis\":{\"diagnosticMode\":\"openFilesOnly\",\"extraPaths\":[\"{tools}/blender-stubs\"]}}}"}
    ]
  },
  "typescript": {
    "match": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"],
    "lint": [
      {"cmd": ["{bin}/biome", "lint", "--reporter=github", "--max-diagnostics=none", "."], "parser": "github", "source": "biome"}
    ],
    "format": [
      {"cmd": ["{bin}/biome", "format", "--write", "{files}"]}
    ],
    "test": [
      {"when_file": ["vitest.config.ts", "vitest.config.js", "vitest.config.mts"], "cmd": ["npx", "vitest", "run", "{tests}"]},
      {"cmd": ["bun", "test", "{tests}"]}
    ],
    "lsp": [
      {"cmd": ["{bin}/typescript-language-server", "--stdio"], "language_id": "typescript", "settle": "publish", "init": "{}"}
    ]
  },
  "go": {
    "match": [".go"],
    "map": "lsp",
    "lsp": [
      {"cmd": ["{tools}/solidlsp/venv/bin/python", "{swan}/tools/solidlsp/bridge.py", "go"],
       "language_id": "go", "settle": "pull", "sealed": true, "runs_repo_code": true,
       "init": "{}",
       "env": ["PYTHONPATH={tools}/solidlsp/src:{swan}/tools/solidlsp/shim", "SWAN_BRIDGE_PATH={tools}/gopls:{tools}/go/bin",
               "SWAN_SOLIDLSP_DATA={out}/solidlsp", "GOCACHE={out}/go/build", "GOPATH={out}/go/path", "GOMODCACHE={tools}/go-mod",
               "GOTOOLCHAIN=local", "PYTHONDONTWRITEBYTECODE=1"]},
      {"cmd": ["{tools}/solidlsp/venv/bin/python", "{swan}/tools/solidlsp/bridge.py", "go"],
       "language_id": "go", "settle": "pull", "sealed": true,
       "init": "{}",
       "env": ["PYTHONPATH={tools}/solidlsp/src:{swan}/tools/solidlsp/shim", "SWAN_BRIDGE_PATH={tools}/gopls:{tools}/go/bin",
               "SWAN_SOLIDLSP_DATA={out}/solidlsp", "GOCACHE={out}/go/build", "GOPATH={out}/go/path", "GOMODCACHE={tools}/go-mod",
               "GOTOOLCHAIN=local", "GOPROXY=off", "PYTHONDONTWRITEBYTECODE=1"]}
    ]
  },
  "goose": {
    "match": [".goose"],
    "map": "lsp",
    "lsp": [
      {"cmd": ["{tools}/goose/goose-v2026.3-linux-x64/goose", "lsp", "--stdio"],
       "when_cmd": ["test", "-d", "{repo}/.tools/goose-home/pkg"],
       "language_id": "goose", "settle": "publish", "sealed": true,
       "init": "{\"entryFiles\":{goose_entry_files}}",
       "env": ["GOOSE_HOME={repo}/.tools/goose-home"]},
      {"cmd": ["{tools}/goose/goose-v2026.3-linux-x64/goose", "lsp", "--stdio"],
       "when_cmd": ["test", "-d", "{tools}/goose-home/pkg"],
       "language_id": "goose", "settle": "publish", "sealed": true,
       "init": "{\"entryFiles\":{goose_entry_files}}",
       "env": ["GOOSE_HOME={tools}/goose-home"]},
      {"cmd": ["{tools}/goose/goose-v2026.3-linux-x64/goose", "lsp", "--stdio"],
       "language_id": "goose", "settle": "publish", "sealed": true,
       "init": "{\"entryFiles\":{goose_entry_files}}"}
    ]
  },
  "java": {
    "match": [".java"],
    "lsp": [
      {"cmd": ["{tools}/jdtls/jre/jdk-25.0.5+8-jre/bin/java", "-Declipse.application=org.eclipse.jdt.ls.core.id1", "-Dosgi.bundles.defaultStartLevel=4", "-Declipse.product=org.eclipse.jdt.ls.core.product", "-Dosgi.checkConfiguration=true", "-Dosgi.sharedConfiguration.area={tools}/jdtls/1.63.0/config_linux", "-Dosgi.sharedConfiguration.area.readOnly=true", "-Dosgi.configuration.cascaded=true", "-Xmx1G", "--add-modules=ALL-SYSTEM", "--add-opens", "java.base/java.util=ALL-UNNAMED", "--add-opens", "java.base/java.lang=ALL-UNNAMED", "-jar", "{tools}/jdtls/1.63.0/plugins/org.eclipse.equinox.launcher_1.8.0.v20260804-1928.jar", "-configuration", "{out}/jdtls-config", "-data", "{out}/jdtls-data"],
       "language_id": "java", "settle": "publish", "runs_repo_code": true,
       "init": "{\"settings\":{\"java\":{\"import\":{\"gradle\":{\"enabled\":true,\"java\":{\"home\":\"{tools}/jdk/jdk-21.0.13+9\"}},\"maven\":{\"enabled\":true},\"exclusions\":[]},\"autobuild\":{\"enabled\":true},\"project\":{\"sourcePaths\":{java_source_paths}}}},\"java\":{\"import\":{\"gradle\":{\"enabled\":true,\"java\":{\"home\":\"{tools}/jdk/jdk-21.0.13+9\"}},\"maven\":{\"enabled\":true},\"exclusions\":[]},\"autobuild\":{\"enabled\":true},\"project\":{\"sourcePaths\":{java_source_paths}}}}",
       "env": ["GRADLE_USER_HOME={tools}/gradle-home"]},
      {"cmd": ["{tools}/jdtls/jre/jdk-25.0.5+8-jre/bin/java", "-Declipse.application=org.eclipse.jdt.ls.core.id1", "-Dosgi.bundles.defaultStartLevel=4", "-Declipse.product=org.eclipse.jdt.ls.core.product", "-Dosgi.checkConfiguration=true", "-Dosgi.sharedConfiguration.area={tools}/jdtls/1.63.0/config_linux", "-Dosgi.sharedConfiguration.area.readOnly=true", "-Dosgi.configuration.cascaded=true", "-Xmx1G", "--add-modules=ALL-SYSTEM", "--add-opens", "java.base/java.util=ALL-UNNAMED", "--add-opens", "java.base/java.lang=ALL-UNNAMED", "-jar", "{tools}/jdtls/1.63.0/plugins/org.eclipse.equinox.launcher_1.8.0.v20260804-1928.jar", "-configuration", "{out}/jdtls-config", "-data", "{out}/jdtls-plain"],
       "language_id": "java", "settle": "publish", "sealed": true,
       "init": "{\"settings\":{\"java\":{\"import\":{\"gradle\":{\"enabled\":false,\"java\":{\"home\":\"{tools}/jdk/jdk-21.0.13+9\"}},\"maven\":{\"enabled\":false},\"exclusions\":[]},\"autobuild\":{\"enabled\":true},\"project\":{\"sourcePaths\":{java_source_paths}}}},\"java\":{\"import\":{\"gradle\":{\"enabled\":false,\"java\":{\"home\":\"{tools}/jdk/jdk-21.0.13+9\"}},\"maven\":{\"enabled\":false},\"exclusions\":[]},\"autobuild\":{\"enabled\":true},\"project\":{\"sourcePaths\":{java_source_paths}}}}"}
    ]
  },
  "kotlin": {
    "match": [".kt", ".kts"],
    "lsp": [
      {"cmd": ["{tools}/kotlin-lsp/kotlin-server-271.2085.0/bin/intellij-server", "--stdio", "--system-path", "{out}/kotlin-lsp"],
       "language_id": "kotlin", "settle": "pull", "init": "{}", "runs_repo_code": true,
       "env": ["GRADLE_USER_HOME={tools}/gradle-home"]}
    ]
  },
  "csharp": {
    "match": [".cs"],
    "lsp": [
      {"cmd": ["{tools}/dotnet-tools/csharp-ls"],
       "language_id": "csharp", "settle": "publish", "init": "{}", "runs_repo_code": true,
       "env": ["DOTNET_ROOT={tools}/dotnet", "DOTNET_CLI_HOME={tools}/dotnet-home", "NUGET_PACKAGES={tools}/nuget",
               "DOTNET_CLI_TELEMETRY_OPTOUT=1", "DOTNET_NOLOGO=1"]}
    ]
  },
  "cpp": {
    "match": [".c", ".cc", ".cpp", ".cxx", ".h", ".hpp", ".hh", ".hxx", ".cu", ".cuh"],
    "lsp": [
      {"cmd": ["{tools}/clangd/clangd_23.1.0/bin/clangd", "--compile-commands-dir={compdb}", "--log=error"],
       "language_id": "cpp", "settle": "publish", "init": "{}"}
    ]
  },
  "lua": {
    "match": [".lua"],
    "lsp": [
      {"cmd": ["{tools}/lua-ls/bin/lua-language-server", "--logpath={out}/lua-ls-log", "--metapath={out}/lua-ls-meta"],
       "language_id": "lua", "settle": "publish", "quiet_ms": 3000, "init": "{}"}
    ]
  },
  "glsl": {
    "match": [".glsl", ".vert", ".frag", ".comp", ".geom", ".tesc", ".tese"],
    "lsp": [
      {"cmd": ["{tools}/shader-ls/bin/shader-language-server", "--glsl", "--stdio"], "language_id": "glsl", "settle": "publish", "init": "{}"}
    ]
  },
  "hlsl": {
    "match": [".hlsl", ".hlsli", ".fx"],
    "lsp": [
      {"cmd": ["{tools}/shader-ls/bin/shader-language-server", "--hlsl", "--stdio"], "language_id": "hlsl", "settle": "publish", "init": "{}"}
    ]
  },
  "wgsl": {
    "match": [".wgsl"],
    "lsp": [
      {"cmd": ["{tools}/shader-ls/bin/shader-language-server", "--wgsl", "--stdio"], "language_id": "wgsl", "settle": "publish", "init": "{}"}
    ]
  },
  "rust": {
    "match": [".rs"],
    "lint": [
      {"cmd": ["cargo", "clippy", "--workspace", "--all-targets", "--message-format=json", "--keep-going", "--quiet"], "parser": "cargo", "source": "clippy", "runs_repo_code": true, "env": ["CARGO_TARGET_DIR={out}/cargo-target"]}
    ],
    "format": [
      {"cmd": ["rustfmt", "--edition", "2021", "{files}"]}
    ],
    "test": [
      {"cmd": ["cargo", "test", "--quiet"], "env": ["CARGO_TARGET_DIR={out}/cargo-target"]}
    ],
    "lsp": [
      {"cmd": ["{tools}/rust-analyzer/rust-analyzer"], "language_id": "rust", "runs_repo_code": true,
       "init": "{\"cargo\":{\"targetDir\":\"{out}/ra-target\"},\"checkOnSave\":true,\"check\":{\"command\":\"check\"}}", "settle": "check",
       "env": ["CARGO_TARGET_DIR={out}/ra-target"]}
    ]
  }
}
