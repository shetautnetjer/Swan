#!/usr/bin/env bash
# swan-up: one command to build, install or update Swan, and connect agents.
#
#   swan-up pack    [--repo DIR] [--ref REF] [--out DIR]
#       On a machine with the Goose compiler: clean-build REF in a private
#       worktree, write a build receipt and export a package folder
#       (archive, install.py, package_support.py, checksums, receipt, swan-up).
#   swan-up install --dist DIR [--root DIR] [--maps DIR] [--profile P]
#                   [--agents claude,pi] [--pi-dir DIR] [--trust-from FILE]
#       On any Linux x86-64 box: install that package into a NEW versioned
#       prefix ROOT/versions/<rev>, carry over trust decisions, switch
#       ROOT/current to it, link ~/.local/bin/swan, register the Swan MCP for
#       the chosen agents, copy the swan-code-check skill, then prove it works.
#   swan-up update  [--repo DIR] [--ref REF] [--root DIR] [--maps DIR]
#                   [--keep N] [--dry-run]
#       From a checkout: fetch, and if REF (default origin/main) is newer than
#       the active version, pack it, install it and switch to it. Then remove
#       old versions: all but the active one, the N before it (default 1, to
#       go back to) and any a running server still uses. --dry-run only says
#       what it would do.
#   swan-up status  [--root DIR]
#       Show the active version and any running Swan servers on an older one.
#
# Agents launch ROOT/current/bin/swan, so a later update is the same command;
# running Swan servers move to the new version by themselves after their
# next answer (swan serve follows the current link; SWAN_NO_RESTART=1 stops it).
# Maps live in --maps (default ROOT/maps), never inside a repository.
# Turn it off: point the agent back at another binary (claude mcp add ...) or
# remove the MCP entry; versions/<rev> folders can be deleted once unused.
set -euo pipefail

die() { echo "swan-up: $*" >&2; exit 1; }
say() { echo "swan-up: $*"; }

ROOT_DEFAULT="${SWAN_ROOT:-$HOME/.local/share/swan}"

cmd_pack() {
  local repo="" ref="origin/main" out="$HOME/.cache/swan/dist"
  while [ $# -gt 0 ]; do case "$1" in
    --repo) repo="$2"; shift 2;; --ref) ref="$2"; shift 2;; --out) out="$2"; shift 2;;
    *) die "pack: unknown option $1";; esac; done
  [ -n "$repo" ] || repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
  local goose="${GOOSE:-$repo/.tools/goose/goose-v2026.3-linux-x64/goose}"
  [ -x "$goose" ] || die "pack needs the Goose compiler (set GOOSE=...); not found at $goose"
  local rev; rev="$(git -C "$repo" rev-parse --verify "$ref^{commit}")" || die "unknown ref $ref"
  local short="${rev:0:12}"
  local work="$out/work-$short" dist="$out/swan-$short"
  if [ -f "$dist/build-receipt.json" ] && [ -f "$dist/swan-up.sha256" ]; then
    say "package already exists: $dist"; echo "$dist"; return 0
  fi
  [ -e "$dist" ] && die "$dist is incomplete; remove it and rerun"
  mkdir -p "$out"; rm -rf "$dist.partial"
  local src="$work/src"
  # build.sh builds the native flattener only when cargo is on PATH; a rustup
  # install often lives in ~/.cargo/bin outside a non-login PATH. Set it here,
  # not in the build subshell, so the license step below finds cargo too.
  if ! command -v cargo >/dev/null 2>&1 && [ -x "$HOME/.cargo/bin/cargo" ]; then
    PATH="$HOME/.cargo/bin:$PATH"; export PATH
  fi
  if [ ! -d "$src" ]; then
    mkdir -p "$work"
    git -C "$repo" worktree add --detach "$src" "$rev" >/dev/null
  fi
  ( cd "$src"
    if [ -d "$repo/lsp/.git" ] || [ -f "$repo/lsp/.git" ]; then
      git -c protocol.file.allow=always -c submodule.lsp.url="$repo/lsp" submodule update --init lsp >/dev/null
    else
      git submodule update --init lsp >/dev/null
    fi
    mkdir -p .tools
    if [ ! -d .tools/goose-home ]; then
      if [ -d "$repo/.tools/goose-home/pkg" ]; then
        mkdir -p .tools/goose-home && cp -a "$repo/.tools/goose-home/pkg" .tools/goose-home/pkg
      else mkdir -p .tools/goose-home; fi
    fi
    say "building $short (log: $work/build.log)"
    GOOSE="$goose" GOOSE_HOME="$src/.tools/goose-home" bash scripts/build.sh > "$work/build.log" 2>&1 \
      || { tail -20 "$work/build.log" >&2; die "build failed"; }
    [ -z "$(git status --porcelain --untracked-files=no)" ] || die "build changed tracked files"
  )
  python3 - "$src" "$rev" "$goose" "$work" <<'PY'
import hashlib, json, platform, subprocess, sys
src, rev, goose, work = sys.argv[1:]
h = lambda p: hashlib.sha256(open(p, "rb").read()).hexdigest()
import os
flatten = f"{src}/bin/swan-flatten"
json.dump({
  "source_revision": rev,
  "binary_sha256": h(f"{src}/bin/swan"),
  "flatten_sha256": h(flatten) if os.path.isfile(flatten) else None,
  "goose_binary_sha256": h(goose),
  "gcc": subprocess.run(["gcc", "--version"], capture_output=True, text=True).stdout.splitlines()[0],
  "system": platform.platform(), "libc": list(platform.libc_ver()),
  "submodules": subprocess.run(["git", "-C", src, "submodule", "status"], capture_output=True, text=True).stdout.strip(),
  "build_command": f"GOOSE={goose} GOOSE_HOME={src}/.tools/goose-home bash scripts/build.sh",
  "build_log": f"{work}/build.log",
}, open(f"{work}/build-receipt.json", "w"), indent=1)
PY
  # Third-party notices for what is compiled in: Goose, goose-sqlite (SQLite),
  # goose-treesitter (tree-sitter and grammars) and goose-lsp.
  local lic="$work/licenses"; rm -rf "$lic"; mkdir -p "$lic"
  local gdir; gdir="$(dirname "$goose")"
  cp "$gdir/LICENSE" "$lic/Goose-LICENSE"
  [ -d "$gdir/licenses" ] && for f in "$gdir"/licenses/*; do [ -f "$f" ] && cp "$f" "$lic/Goose-$(basename "$f")"; done
  cp "$src/lsp/LICENSE" "$lic/goose-lsp-LICENSE"
  local pkg
  for pkg in goose-sqlite goose-treesitter; do
    local d; d="$(ls -d "$src/.tools/goose-home/pkg/github.com/shetautnetjer/$pkg"/*/ 2>/dev/null | head -1)"
    [ -n "$d" ] && [ -f "$d/LICENSE" ] && cp "$d/LICENSE" "$lic/$pkg-LICENSE"
  done
  find "$src/.tools/goose-home/pkg" -path '*tree-sitter*' -iname 'LICENSE*' -type f 2>/dev/null | while read -r f; do
    cp "$f" "$lic/$(echo "${f#$src/.tools/goose-home/pkg/}" | tr '/' '_')"; done
  # The native flattener ships when it was built; its compiled-in Rust crates
  # (rayon and what it pulls in) bring their own license files.
  local flatten_args=()
  if [ -f "$src/bin/swan-flatten" ]; then
    flatten_args=(--flatten "$src/bin/swan-flatten")
    ( cd "$src/native/swan-flatten" && cargo metadata --offline --locked --format-version 1 2>/dev/null ) \
      | python3 -c '
import json, os, shutil, sys
lic = sys.argv[1]
for p in json.load(sys.stdin)["packages"]:
    if p["source"] is None:
        continue  # swan-flatten itself
    d = os.path.dirname(p["manifest_path"])
    for f in sorted(os.listdir(d)):
        if f.upper().startswith(("LICENSE", "COPYING", "NOTICE")) and os.path.isfile(os.path.join(d, f)):
            shutil.copyfile(os.path.join(d, f), os.path.join(lic, "rust-%s-%s-%s" % (p["name"], p["version"], f)))
' "$lic" || say "warning: could not collect Rust crate licenses for swan-flatten"
    say "swan-flatten built; the package ships the native flattener"
  else
    say "warning: swan-flatten was not built (no cargo); this package uses tools/scip-flatten.ts"
  fi
  python3 "$src/scripts/package.py" --binary "$src/bin/swan" --output "$dist.partial" \
    --source-revision "$rev" --build-receipt "$work/build-receipt.json" \
    --licenses "$lic" --require-license Goose-LICENSE "${flatten_args[@]}" >/dev/null
  cp "$work/build-receipt.json" "$dist.partial/"
  cp "$src/scripts/swan-up" "$dist.partial/swan-up"
  ( cd "$dist.partial" && sha256sum swan-up > swan-up.sha256 )
  mv -T "$dist.partial" "$dist"     # only a complete package gets the final name
  git -C "$repo" worktree remove --force "$src" >/dev/null 2>&1 || true
  say "package ready: $dist"
  echo "$dist"
}

backup_dir() { echo "$HOME/.local/share/swan/backups/$(date +%Y%m%d-%H%M%S)"; }

install_skill() {   # install_skill <from-skill-dir> <skills-parent-dir>
  local from="$1" parent="$2" to="$2/swan-code-check"
  mkdir -p "$parent"
  if [ -d "$to" ] && ! diff -rq "$from" "$to" >/dev/null 2>&1; then
    local b; b="$(backup_dir)/$(echo "$parent" | tr '/' '_')"; mkdir -p "$b"
    cp -a "$to" "$b/" && say "kept the old skill copy in $b"
  fi
  rm -rf "$to.new"; cp -a "$from" "$to.new"; rm -rf "$to"; mv "$to.new" "$to"
  say "skill installed: $to"
}

connect_claude() {  # connect_claude <binary> <maps>
  local claude; claude="$(command -v claude || true)"
  [ -n "$claude" ] || { say "claude not found on PATH; skipped Claude Code"; return 0; }
  local b; b="$(backup_dir)"; mkdir -p "$b"
  local old="$b/claude-mcp-swan.json"
  python3 -c 'import json,os,sys
p=os.path.expanduser("~/.claude.json")
e=json.load(open(p)).get("mcpServers",{}).get("swan") if os.path.exists(p) else None
e and json.dump(e,open(sys.argv[1],"w"))' "$old" 2>/dev/null || true
  "$claude" mcp remove swan -s user >/dev/null 2>&1 || true
  if ! "$claude" mcp add swan -s user -- "$1" serve --maps "$2" >/dev/null 2>"$b/claude-mcp-add.err"; then
    if [ -s "$old" ] && "$claude" mcp add-json swan "$(cat "$old")" -s user >/dev/null 2>&1; then
      say "WARNING: could not register the new Swan in Claude Code (see $b/claude-mcp-add.err); the previous entry was put back."
    else
      say "WARNING: could not register Swan in Claude Code (see $b/claude-mcp-add.err); previous entry saved in $old."
    fi
    SWAN_UP_WARN=1; return 0
  fi
  say "Claude Code (user scope) now launches: $1 serve --maps $2"
  install_skill "$PREFIX/skills/swan-code-check" "$HOME/.claude/skills"
}

connect_pi() {      # connect_pi <binary> <maps> <pi-dir>
  local dir="$3"; mkdir -p "$dir"
  if [ -f "$dir/mcp.json" ]; then local b; b="$(backup_dir)"; mkdir -p "$b"; cp "$dir/mcp.json" "$b/pi-mcp.json"; fi
  python3 - "$dir/mcp.json" "$1" "$2" <<'PY'
import json, os, sys
path, binary, maps = sys.argv[1:]
data = json.load(open(path)) if os.path.exists(path) else {}
data.setdefault("mcpServers", {})["swan"] = {"command": binary, "args": ["serve", "--maps", maps]}
tmp = path + ".tmp"; json.dump(data, open(tmp, "w"), indent=2); os.replace(tmp, path)
PY
  say "pi ($dir/mcp.json) now launches: $1 serve --maps $2"
  install_skill "$PREFIX/skills/swan-code-check" "$dir/skills"
}

smoke_mcp() {       # prove an MCP client can start this Swan and list its tools
  python3 - "$1" "$2" <<'PY'
import json, queue, subprocess, sys, threading, time
binary, maps = sys.argv[1:]
p = subprocess.Popen([binary, "serve", "--maps", maps], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
lines = queue.Queue()
threading.Thread(target=lambda: [lines.put(l) for l in p.stdout] + [lines.put(None)], daemon=True).start()
def send(msg):
    p.stdin.write(json.dumps(msg) + "\n"); p.stdin.flush()
def reply(i, timeout=30):
    end = time.time() + timeout
    while True:
        try:
            line = lines.get(timeout=max(0.01, end - time.time()))
        except queue.Empty:
            p.kill(); sys.exit(f"swan-up: MCP check failed: no reply to request {i} in {timeout}s")
        if line is None:
            sys.exit("swan-up: MCP check failed: server exited")
        try:
            msg = json.loads(line)
        except ValueError:
            continue                       # a log line, not a reply
        if msg.get("id") == i:
            return msg
send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
      "params": {"protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": {"name": "swan-up", "version": "1"}}})
init = reply(1)
send({"jsonrpc": "2.0", "method": "notifications/initialized"})
send({"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}})
tools = reply(2)["result"]["tools"]
p.stdin.close()
try: p.wait(timeout=10)
except subprocess.TimeoutExpired: p.kill()
print(f"swan-up: MCP ok: {init['result']['serverInfo'].get('name')} answers with {len(tools)} tools")
PY
}

cmd_install() {
  local dist="" root="$ROOT_DEFAULT" maps="" profile="python-typescript" agents="claude,pi"
  local pidir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" trust_from="" langs="${SWAN_LANGS:-c,java,rust}"
  while [ $# -gt 0 ]; do case "$1" in
    --dist) dist="$2"; shift 2;; --root) root="$2"; shift 2;; --maps) maps="$2"; shift 2;;
    --profile) profile="$2"; shift 2;; --agents) agents="$2"; shift 2;;
    --pi-dir) pidir="$2"; shift 2;; --trust-from) trust_from="$2"; shift 2;;
    --langs) langs="$2"; shift 2;; --no-langs) langs=""; shift;;
    *) die "install: unknown option $1";; esac; done
  [ -d "$dist" ] || die "install needs --dist <package folder from swan-up pack>"
  dist="$(cd "$dist" && pwd)"; root="$(mkdir -p "$root" && cd "$root" && pwd)"
  maps="${maps:-${SWAN_MAPS:-$root/maps}}"; mkdir -p "$maps"; maps="$(cd "$maps" && pwd)"
  ( cd "$dist" && sha256sum -c --quiet install.py.sha256 package_support.py.sha256 swan-linux-x86_64.tar.gz.sha256 ) \
    || die "package checksums do not match"
  local rev; rev="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["source_revision"])' "$dist/build-receipt.json")"
  PREFIX="$root/versions/${rev:0:12}"
  if [ -x "$PREFIX/bin/swan" ] && "$PREFIX/bin/swan" doctor --profile "$profile" --json >/dev/null 2>&1; then
    say "version ${rev:0:12} already installed at $PREFIX"
  else
    [ -e "$PREFIX" ] && die "$PREFIX exists but fails doctor; move it aside and rerun"
    mkdir -p "$root/versions"
    python3 -I "$dist/install.py" --archive "$dist/swan-linux-x86_64.tar.gz" \
      --sha256 "$(cut -d ' ' -f 1 "$dist/swan-linux-x86_64.tar.gz.sha256")" \
      --prefix "$PREFIX" --profile "$profile" | sed 's/^/  /'
  fi
  # Provision the SCIP map indexers for the requested languages into the prefix
  # (C/C++, Java, Rust, ...). TypeScript and Python ship in the package; the
  # rest are fetched here (pinned, checksum-verified) so a normal install maps
  # every language. Idempotent: already-present indexers are left as they are.
  # Non-fatal: a language that fails to fetch simply will not map; the install
  # still switches, and python/typescript are unaffected.
  if [ -n "$langs" ] && [ -x "$PREFIX/scripts/fetch-tools.sh" ]; then
    say "provisioning language indexers: $langs"
    if ( cd "$PREFIX" && SWAN_RUNTIME_ONLY=1 SWAN_LANGS="$langs" bash scripts/fetch-tools.sh ); then
      say "language indexers ready: $langs"
    else
      say "warning: some language indexers did not provision ($langs); those languages will not map until provisioned"
    fi
  fi
  # Trust decisions belong to the person, not the version: carry them forward, never add new ones.
  local trust="$PREFIX/data/trusted-repos"; mkdir -p "$PREFIX/data"; touch "$trust"
  local src
  for src in "$root/current/data/trusted-repos" "$trust_from"; do
    [ -n "$src" ] && [ -f "$src" ] && [ "$(readlink -f "$src")" != "$(readlink -f "$trust")" ] \
      && sort -u "$trust" "$src" -o "$trust"
  done
  # Prove the new version works before anything points at it.
  "$PREFIX/bin/swan" doctor --profile "$profile" --json >/dev/null && say "doctor: ready ($profile)" \
    || die "doctor failed; nothing was switched"
  smoke_mcp "$PREFIX/bin/swan" "$maps" || die "MCP check failed; nothing was switched"
  python3 -I "$PREFIX/skills/swan-code-check/scripts/selftest.py" --swan "$PREFIX/bin/swan" | tail -1 \
    || die "skill self-test failed; nothing was switched"
  ln -sfn "versions/${rev:0:12}" "$root/current.new" && mv -T "$root/current.new" "$root/current"
  local bin="$root/current/bin/swan"
  mkdir -p "$HOME/.local/bin"
  if [ -e "$HOME/.local/bin/swan" ] && [ ! -L "$HOME/.local/bin/swan" ]; then
    local b; b="$(backup_dir)"; mkdir -p "$b"; mv "$HOME/.local/bin/swan" "$b/"; fi
  ln -sfn "$bin" "$HOME/.local/bin/swan"
  say "active: ${rev:0:12} (swan on PATH -> $bin); maps in $maps"
  case ",$agents," in *,claude,*) connect_claude "$bin" "$maps";; esac
  case ",$agents," in *,pi,*) connect_pi "$bin" "$maps" "$pidir";; esac
  cmd_status --root "$root"
  [ -z "${SWAN_UP_WARN:-}" ] || { say "finished with warnings (see above)"; exit 3; }
}

cmd_status() {
  local root="$ROOT_DEFAULT"
  [ "${1:-}" = "--root" ] && root="$2"
  local cur; cur="$(readlink -f "$root/current/bin/swan" 2>/dev/null || true)"
  [ -n "$cur" ] && say "current: $cur" || say "no current version under $root"
  local pid exe
  for pid in $(pgrep -u "$(id -u)" -f 'swan serve' || true); do
    exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    case "$exe" in */swan|*/swan\ \(deleted\))
      [ "$exe" = "$cur" ] || say "still on an older Swan; it moves after its next answer: pid $pid ($exe)";;
    esac
  done
}

# The version folders running Swan servers were started from, one per line.
versions_in_use() {
  local pid exe
  for pid in $(pgrep -u "$(id -u)" -f 'swan serve' || true); do
    exe="$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)"
    exe="${exe% (deleted)}"
    case "$exe" in */versions/*/bin/swan) dirname "$(dirname "$exe")";; esac
  done
}

cmd_update() {
  local repo="" ref="origin/main" root="$ROOT_DEFAULT" maps="" keep=1 dry=""
  while [ $# -gt 0 ]; do case "$1" in
    --repo) repo="$2"; shift 2;; --ref) ref="$2"; shift 2;; --root) root="$2"; shift 2;;
    --maps) maps="$2"; shift 2;; --keep) keep="$2"; shift 2;; --dry-run) dry=1; shift;;
    *) die "update: unknown option $1";; esac; done
  [ -n "$repo" ] || repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
  git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "update runs from a Swan checkout (or pass --repo DIR)"
  case "$keep" in ''|*[!0-9]*) die "update: --keep takes a number";; esac
  root="$(mkdir -p "$root" && cd "$root" && pwd)"
  case "$ref" in origin/*) git -C "$repo" fetch --quiet origin || die "cannot fetch origin";; esac
  local rev; rev="$(git -C "$repo" rev-parse --verify "$ref^{commit}")" || die "unknown ref $ref"
  local short="${rev:0:12}" cur=""
  cur="$(basename "$(readlink -f "$root/current" 2>/dev/null || true)")"
  if [ "$cur" = "$short" ]; then
    say "already on $short, the latest $ref"
  elif [ -n "$dry" ]; then
    say "would build and install $short ($ref); active now: ${cur:-none}"
  else
    say "updating ${cur:-nothing} -> $short ($ref)"
    local dist; dist="$(cmd_pack --repo "$repo" --ref "$ref" | tail -1)"
    [ -d "$dist" ] || die "pack did not produce a package folder"
    if [ -n "$maps" ]; then cmd_install --dist "$dist" --root "$root" --maps "$maps"
    else cmd_install --dist "$dist" --root "$root"; fi
    cur="$short"
  fi
  # Old versions: keep the active one, the newest $keep others, and any in use.
  local in_use; in_use="$(versions_in_use | sort -u)"
  local kept=0 v name freed=0 size
  for v in $(ls -1dt "$root"/versions/*/ 2>/dev/null); do
    v="${v%/}"; name="$(basename "$v")"
    [ "$name" = "$cur" ] && continue
    if printf '%s\n' "$in_use" | grep -qxF "$v"; then say "kept $name: a running Swan server still uses it"; continue; fi
    if [ "$kept" -lt "$keep" ]; then kept=$((kept + 1)); say "kept $name: the version before, to go back to"; continue; fi
    case "$v" in "$root"/versions/?*) ;; *) die "refusing to remove $v";; esac
    size="$(du -sm "$v" 2>/dev/null | cut -f1)"; size="${size:-0}"
    if [ -n "$dry" ]; then say "would remove $name ($size MB)"
    else rm -rf -- "${v:?}"; say "removed $name ($size MB)"; fi
    freed=$((freed + size))
  done
  [ "$freed" -gt 0 ] && say "$([ -n "$dry" ] && echo "would free" || echo "freed") $freed MB"
  cmd_status --root "$root"
}

case "${1:-}" in
  pack) shift; cmd_pack "$@";;
  update) shift; cmd_update "$@";;
  install) shift; cmd_install "$@";;
  status) shift; cmd_status "$@";;
  *) sed -n '2,30p' "$0"; exit 2;;
esac
